<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Live streams come from the Hik-Connect cloud relay. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Runs on Android TV (leanback) and on phones/tablets (touchscreen); neither is mandatory. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Backup asks whether a documents UI handles CREATE_DOCUMENT (phones: yes, Android TV: no)
         to choose between the Storage Access Framework and the Downloads folder; from API 30 the
         package manager only answers for intents declared here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <data android:mimeType="application/json" />
        </intent>
    </queries>

    <application
        android:name=".HikViewerApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HikViewer"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Phone / tablet home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android TV home screen (needs android:banner above). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The grid and the phone camera screen are recreated on rotation (portrait → 2 columns;
             live + timeline → picture alone) and keep their state in their ViewModels. -->
        <activity
            android:name=".ui.grid.GridActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.fullscreen.FullscreenActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />
        <!-- Follows the phone's orientation: layout/ upright, layout-land/ sideways. -->
        <activity
            android:name=".ui.phone.PhoneCameraActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <!-- A QR code on black (UPI, GitHub); follows the device's orientation so a phone can hold it either way. -->
        <activity
            android:name=".ui.settings.QrActivity"
            android:exported="false"
            android:theme="@style/Theme.HikViewer.Qr" />
        <activity
            android:name=".ui.playback.PlaybackActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />
    </application>

</manifest>
