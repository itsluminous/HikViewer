<?xml version="1.0" encoding="utf-8"?>
<!-- Donate via UPI: the QR code fills what the screen allows (fitCenter keeps its aspect; the
     bitmap lives in drawable-nodpi so no density scaling blurs the modules), the UPI id under it
     for typing, and the way out. The black comes from Theme.HikViewer.Donate's window background, so
     the QR contrast is the picture's own and nothing is painted twice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.settings.DonateActivity">

    <ImageView
        android:id="@+id/qr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/donate_qr_description"
        android:scaleType="fitCenter"
        android:src="@drawable/upi_qr" />

    <TextView
        android:id="@+id/upi_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/upi_id"
        android:textColor="@android:color/white"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/donate_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/donate_hint"
        android:textColor="@color/on_background"
        android:textSize="14sp" />
</LinearLayout>
