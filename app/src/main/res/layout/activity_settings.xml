<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.settings.SettingsActivity">

    <!-- One column, as wide as the screen allows up to form_width: on a TV the 420 dp form it
         always was, on a 360 dp phone the full width, so no switch thumb or "signal" label ends
         up past the edge. Sections top to bottom: Grid layout, Tile overlays, Fullscreen quality,
         Screen (phones), Live cameras, Visible cameras and order, Change encryption password,
         About, Logout; every section head carries the "section" tag so a test can walk them. No nextFocus* attributes: the D-pad follows this visual order on its own. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/form_column_width">

            <TextView
                style="@style/TextAppearance.HikViewer.Title"
                android:text="@string/settings_title" />

            <TextView
                android:id="@+id/section_layout"
                style="@style/TextAppearance.HikViewer.Label"
                android:tag="@string/settings_section_tag"
                android:labelFor="@id/layout_spinner"
                android:text="@string/settings_layout" />

            <Spinner
                android:id="@+id/layout_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/section_overlays"
                style="@style/TextAppearance.HikViewer.Label"
                android:tag="@string/settings_section_tag"
                android:text="@string/settings_overlays" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/show_names"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_show_names"
                android:textColor="@color/on_background" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/show_fps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_show_fps"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/section_quality"
                style="@style/TextAppearance.HikViewer.Label"
                android:tag="@string/settings_section_tag"
                android:text="@string/settings_quality" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/quality_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_quality_main"
                android:textColor="@color/on_background" />

            <!-- Phones only: a TV never dims while video plays, so the section is hidden there. -->
            <LinearLayout
                android:id="@+id/screen_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/section_screen"
                    style="@style/TextAppearance.HikViewer.Label"
                    android:tag="@string/settings_section_tag"
                    android:text="@string/settings_screen" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/keep_screen_on"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_keep_screen_on"
                    android:textColor="@color/on_background" />
            </LinearLayout>

            <TextView
                android:id="@+id/section_cameras"
                style="@style/TextAppearance.HikViewer.Label"
                android:tag="@string/settings_section_tag"
                android:text="@string/settings_cameras" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_cameras_help"
                android:textColor="#B0F2F4F7"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/camera_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- The button is the whole section, so it carries the section tag itself. -->
            <Button
                android:id="@+id/change_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:tag="@string/settings_section_tag"
                android:text="@string/settings_change_code" />

            <TextView
                android:id="@+id/section_about"
                style="@style/TextAppearance.HikViewer.Label"
                android:tag="@string/settings_section_tag"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_background"
                tools:text="HikViewer 0.1.0" />

            <!-- The source address as plain text: a TV has no browser to open it, so the user reads
                 it off the screen. Not focusable (a focusable TextView would join the D-pad walk);
                 SettingsActivity makes it selectable on phones for copying. -->
            <TextView
                android:id="@+id/source_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:focusable="false"
                android:text="@string/settings_source_url"
                android:textColor="@color/on_background" />

            <!-- Donate opens DonateActivity: the QR code fullscreen, since a TV has no UPI app. -->
            <Button
                android:id="@+id/donate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_donate"
                android:textAllCaps="false"
                android:textColor="@color/on_background" />

            <Button
                android:id="@+id/logout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:tag="@string/settings_section_tag"
                android:text="@string/settings_logout"
                android:textColor="@color/error_text" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
