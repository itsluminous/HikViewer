<?xml version="1.0" encoding="utf-8"?>
<!-- The phone camera screen's transport: the playhead, the day's time bar, the day arrows with
     the date, the speed and Live buttons. Included by both orientations' layouts; the landscape
     variant (layout-land) has the same ids on one compact row so the Activity binds them alike. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/time_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/on_background"
        android:textSize="28sp"
        tools:text="17:13:51" />

    <!-- The device's local time, only when the recorder's clock differs (see RecorderTimeLabel). -->
    <TextView
        android:id="@+id/local_time_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/on_background_secondary"
        android:textSize="20sp"
        android:visibility="gone"
        tools:text="Local time  10:34 PT (+13:30)"
        tools:visibility="visible" />

    <com.itsluminous.hikviewer.ui.playback.TimeBarView
        android:id="@+id/time_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/playback_bar_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/day_back"
            style="@style/Widget.HikViewer.BarButton"
            android:layout_marginStart="0dp"
            android:contentDescription="@string/phone_day_back"
            android:text="@string/phone_arrow_back" />

        <TextView
            android:id="@+id/date_chip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            tools:text="2026-11-04" />

        <Button
            android:id="@+id/day_forward"
            style="@style/Widget.HikViewer.BarButton"
            android:contentDescription="@string/phone_day_forward"
            android:text="@string/phone_arrow_forward" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/speed_button"
            style="@style/Widget.HikViewer.BarButton"
            android:layout_marginStart="0dp"
            android:minWidth="72dp"
            tools:text="1x" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/live_button"
            style="@style/Widget.HikViewer.BarButton"
            android:text="@string/phone_live_button" />
    </LinearLayout>
</LinearLayout>
