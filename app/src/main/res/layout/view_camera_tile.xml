<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_margin="6dp"
        android:background="@drawable/label_background"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/on_background"
        android:textSize="14sp"
        tools:text="Gate" />

    <ProgressBar
        android:id="@+id/spinner"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/on_background"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Dim scrim and a single centred Retry: shown only while the stream is not running. The
         button is not focusable so D-pad focus stays on the tile; the tile's OK retries. -->
    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tile_dim"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/on_background"
            android:textSize="13sp"
            tools:text="No video" />

        <Button
            android:id="@+id/retry"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="96dp"
            android:text="@string/tile_retry" />
    </LinearLayout>

    <View
        android:id="@+id/focus_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tile_focus_frame"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

</merge>
