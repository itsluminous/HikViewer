<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Keyframe thumbnails of a tile that is not live, drawn over the (idle) surface; stretched like
         the decoder stretches a live picture onto the surface. -->
    <ImageView
        android:id="@+id/still"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_margin="6dp"
        android:background="@drawable/label_background"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/on_background"
        android:textSize="14sp"
        tools:text="Gate" />

    <!-- Live dot, top-right: green while pictures reach the screen, red while none has for ~2 s. -->
    <View
        android:id="@+id/live_dot"
        android:layout_width="@dimen/live_dot_size"
        android:layout_height="@dimen/live_dot_size"
        android:layout_gravity="end|top"
        android:layout_margin="@dimen/live_dot_margin"
        android:background="@drawable/live_dot"
        android:backgroundTint="@color/live_dot_stalled"
        android:importantForAccessibility="no" />

    <!-- Optional rendered-fps counter (Settings → Show frame rate), to the left of the dot. -->
    <TextView
        android:id="@+id/fps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/fps_margin_end"
        android:background="@drawable/label_background"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:textColor="@color/on_background"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="25 fps"
        tools:visibility="visible" />

    <!-- Connecting cue: an 8-steps-a-second arc (see tile_spinner.xml), not the platform's
         60 fps AnimatedVectorDrawable. -->
    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/tile_spinner"
        android:indeterminateOnly="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Dim scrim, the reason and a single centred retry icon: shown only while the stream is not
         running. The icon is a transparent, focusable ImageButton (a pointer or accessibility can
         land on it; it grows 10 % with focus); the D-pad stays on the tile itself because the tile
         takes focus before its descendants, and OK on the tile retries too. -->
    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tile_dim"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/on_background"
            android:textSize="13sp"
            tools:text="No video" />

        <ImageButton
            android:id="@+id/retry"
            android:layout_width="@dimen/tile_retry_icon"
            android:layout_height="@dimen/tile_retry_icon"
            android:background="@null"
            android:contentDescription="@string/tile_retry"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_retry" />
    </LinearLayout>

    <!-- Last child: the focus border is drawn above everything else in the tile, inset inside it. -->
    <com.itsluminous.hikviewer.ui.grid.TileFocusOverlay
        android:id="@+id/focus_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

</merge>
