<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HikViewer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.HikViewer.Dialog</item>
    </style>

    <!-- The donate screen: a black window behind the QR code, so there is no flash of the dark
         grey background before the layout draws. -->
    <style name="Theme.HikViewer.Donate" parent="Theme.HikViewer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.HikViewer.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@color/tile_background</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <!-- Top-bar buttons: text + icon, visible focus from the Material button background. -->
    <style name="Widget.HikViewer.BarButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/on_background</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.HikViewer.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearance.HikViewer.Label" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/accent</item>
    </style>
</resources>
